#!/usr/bin/env bash
# Launcher for the relocatable macOS opengrads-hpc release archive.

set -euo pipefail

bundle_root="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
export GA_ROOT="$bundle_root/plugins"
export GAUDPT="$bundle_root/etc/udpt"
export GADDIR="$bundle_root/cola/data"
export GASCRP="$bundle_root/lib/scripts${GASCRP:+:$GASCRP}"

# The bundled ncurses has the build machine's terminfo path compiled into it,
# and that directory does not exist here, so terminal lookup fails and the
# prompt falls back to dumb terminal settings. Point it at the usual system
# locations; the trailing empty entry keeps the compiled-in default as a last
# resort. An explicit TERMINFO or TERMINFO_DIRS from the caller always wins.
if [[ -z "${TERMINFO:-}" && -z "${TERMINFO_DIRS:-}" ]]; then
  export TERMINFO_DIRS="/usr/share/terminfo:/lib/terminfo:/etc/terminfo:"
fi

# The terminal display (-d Term) starts this in the tmux pane it draws into.
if [[ -z "${GA_TERM_VIEWER:-}" && -x "$bundle_root/libexec/grads-termview" ]]; then
  export GA_TERM_VIEWER="$bundle_root/libexec/grads-termview"
fi

# The default display, Cairo, draws in an X window, which needs an X server:
# XQuartz provides one and sets DISPLAY for the login session (it starts on
# demand). Without one, in iTerm2 or WezTerm, the terminal display (Term)
# shows the pictures in the terminal itself, here or over ssh; elsewhere the
# archive runs headless on gxdummy, and pictures go to files with printim
# and print. Fill in the drivers unless the caller named them.
have_x=0
if [[ -n "${DISPLAY:-}" && -r "$GA_ROOT/libgxdCairo.dylib" ]]; then
  have_x=1
fi

# Does the terminal show iTerm2 inline images? iTerm2 sets LC_TERMINAL, which
# ssh forwards with the other LC_* variables. OPENGRADS_TERM=1 or 0 overrides
# the guess.
terminal_shows_images()
{
  case "${OPENGRADS_TERM:-}" in
    1) return 0 ;;
    0) return 1 ;;
  esac
  [[ -t 1 ]] || return 1
  case "${LC_TERMINAL:-}:${TERM_PROGRAM:-}" in
    iTerm2:*|*:iTerm.app|WezTerm:*|*:WezTerm) return 0 ;;
  esac
  return 1
}

# An X server wins unless the terminal display was asked for by name.
use_term=0
if [[ -r "$GA_ROOT/libgxdTerm.dylib" ]]; then
  if [[ "${OPENGRADS_TERM:-}" == 1 ]] ||
     { (( ! have_x )) && terminal_shows_images; }; then
    use_term=1
  fi
fi

args=("$@")
if [[ "$#" -eq 0 ]]; then
  if (( have_x || use_term )); then
    args=(-l)
  else
    args=(-bl)
  fi
fi

have_display=0
have_print=0
for arg in "$@"; do
  case "$arg" in
    -d) have_display=1 ;;
    -h) have_print=1 ;;
  esac
done
if (( ! have_display )); then
  if (( use_term )); then
    args+=(-d Term)
  elif (( ! have_x )); then
    args+=(-d gxdummy)
  fi
fi
(( have_print )) || args+=(-h Cairo)

exec "$bundle_root/bin/grads" "${args[@]}"
