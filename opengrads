#!/usr/bin/env bash
# Added in 2026 for BP5 runtime setup, local plug-ins, and color; see COPYING.

set -euo pipefail

repo_root="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

if [[ -n "${OPENGRADS_BUILD_ROOT:-}" ]]; then
  build_root="$OPENGRADS_BUILD_ROOT"
elif [[ -x "$repo_root/build/src/grads" ]]; then
  build_root="$repo_root/build"
elif [[ -x /tmp/opengrads-build-cpu/src/grads ]]; then
  build_root=/tmp/opengrads-build-cpu
else
  build_root="$repo_root/build"
fi

grads_binary="$build_root/src/grads"
if [[ ! -x "$grads_binary" ]]; then
  printf 'OpenGrADS executable was not found at:\n  %s\n' "$grads_binary" >&2
  printf 'Build it using:\n  %s/docs/INSTALL.md\n' "$repo_root" >&2
  printf 'Or set OPENGRADS_BUILD_ROOT to an existing build directory.\n' >&2
  exit 1
fi

bundle_root="${OPENGRADS_BUNDLE_ROOT:-}"
bundle_root_explicit=0
if [[ -n "${OPENGRADS_BUNDLE_ROOT:-}" ]]; then
  bundle_root_explicit=1
fi
if [[ -z "$bundle_root" ]]; then
  for candidate in "$repo_root/opengrads/Contents" \
                   "$repo_root/../opengrads-2.2.1.oga.1/Contents"; do
    if [[ -d "$candidate" ]]; then
      bundle_root="$candidate"
      break
    fi
  done
fi

runtime_kind=local
if [[ -n "$bundle_root" && -d "$bundle_root" ]]; then
  platform="$(uname -s)"
  machine="$(uname -m)"
  version_file="$bundle_root/$platform/Versions/Current@"
  if [[ -r "$version_file" ]]; then
    bundle_version="$(<"$version_file")"
    platform_root="$bundle_root/$platform/Versions/$bundle_version/$machine"
  else
    platform_root="$bundle_root/$platform/$machine"
  fi
  plugin_dir="$platform_root/gex"
  plugin_table="$plugin_dir/udpt"
  extension_table="$plugin_dir/udxt"
  support_dir="$bundle_root/Resources/SupportData"
  script_dir="$bundle_root/Resources/Scripts"
  if [[ -r "$plugin_table" || "$bundle_root_explicit" -eq 1 ]]; then
    runtime_kind=bundle
  else
    bundle_root=""
  fi
fi

if [[ "$runtime_kind" == local ]]; then
  plugin_dir="$build_root/src/.libs"
  plugin_table="$repo_root/etc/udpt-local"
  extension_table=""
  support_dir="$repo_root/cola/data"
  script_dir="$repo_root/lib/scripts"
  export GA_ROOT="$plugin_dir"

  if [[ ! -r "$plugin_dir/libgxdummy.so" ]]; then
    printf 'The local gxdummy graphics plug-in was not found at:\n  %s\n' \
      "$plugin_dir/libgxdummy.so" >&2
    printf 'Build it using:\n  %s/docs/INSTALL.md\n' "$repo_root" >&2
    exit 1
  fi
fi

if [[ ! -r "$plugin_table" ]]; then
  printf 'OpenGrADS graphics plug-in table was not found at:\n  %s\n' \
    "$plugin_table" >&2
  printf 'See %s/docs/INSTALL.md\n' "$repo_root" >&2
  exit 1
fi

export GAUDPT="$plugin_table"
export GADDIR="$support_dir"
if [[ -r "$extension_table" ]]; then
  export GA2UDXT="$extension_table"
else
  unset GA2UDXT || true
fi

if [[ -n "${GASCRP:-}" ]]; then
  export GASCRP="$GASCRP $script_dir"
else
  export GASCRP="$script_dir"
fi

platform="$(uname -s)"
if [[ "$platform" == Darwin ]]; then
  if [[ -n "${DYLD_LIBRARY_PATH:-}" ]]; then
    export DYLD_LIBRARY_PATH="$plugin_dir:$DYLD_LIBRARY_PATH"
  else
    export DYLD_LIBRARY_PATH="$plugin_dir"
  fi
else
  if [[ -d "$repo_root/adios2" || -d "$repo_root/deps" ]]; then
    install_root="$repo_root"
  else
    install_root="$(CDPATH= cd -- "$repo_root/.." && pwd)"
  fi
  adios2_root="${OPENGRADS_ADIOS2_ROOT:-$install_root/adios2}"
  local_deps_root="${OPENGRADS_DEPS_ROOT:-$install_root/deps}"
  library_path="$plugin_dir"
  if [[ -d "$local_deps_root/lib" ]]; then
    library_path="$local_deps_root/lib:$library_path"
  fi
  if [[ -d "$adios2_root/lib" ]]; then
    library_path="$adios2_root/lib:$library_path"
  fi
  if [[ -n "${OPENGRADS_EXTRA_LIBRARY_PATH:-}" ]]; then
    library_path="$library_path:$OPENGRADS_EXTRA_LIBRARY_PATH"
  fi
  if [[ -n "${LD_LIBRARY_PATH:-}" ]]; then
    library_path="$library_path:$LD_LIBRARY_PATH"
  fi
  export LD_LIBRARY_PATH="$library_path"

  if [[ "$runtime_kind" == bundle ]]; then
    # The legacy bundle carries an old libstdc++. Preload ADIOS2's runtime so
    # the graphics directory cannot override the C++ ABI required by ADIOS2.
    cxx_runtime="${OPENGRADS_CXX_RUNTIME:-}"
    if [[ -z "$cxx_runtime" && -n "$adios2_root" &&
          -f "$adios2_root/lib/libstdc++.so.6" ]]; then
      cxx_runtime="$adios2_root/lib/libstdc++.so.6"
    fi
    if [[ -z "$cxx_runtime" &&
          -f "$local_deps_root/lib/libstdc++.so.6" ]]; then
      cxx_runtime="$local_deps_root/lib/libstdc++.so.6"
    fi
    if [[ -z "$cxx_runtime" ]]; then
      adios2_library=""
      while read -r library arrow resolved remainder; do
        if [[ "$library" == libadios2_c.so* && "$resolved" == /* ]]; then
          adios2_library="$resolved"
          break
        fi
      done < <(env -u LD_LIBRARY_PATH ldd "$grads_binary" 2>/dev/null || true)
      if [[ -n "$adios2_library" &&
            -f "$(dirname -- "$adios2_library")/libstdc++.so.6" ]]; then
        cxx_runtime="$(dirname -- "$adios2_library")/libstdc++.so.6"
      fi
    fi
    if [[ -z "$cxx_runtime" && -x /usr/bin/c++ ]]; then
      cxx_runtime="$(/usr/bin/c++ -print-file-name=libstdc++.so.6 \
        2>/dev/null || true)"
    fi
    if [[ -z "$cxx_runtime" ]] && command -v c++ >/dev/null 2>&1; then
      cxx_runtime="$(c++ -print-file-name=libstdc++.so.6 2>/dev/null || true)"
    fi
    if [[ -n "$cxx_runtime" && -f "$cxx_runtime" ]]; then
      export LD_PRELOAD="$cxx_runtime${LD_PRELOAD:+:$LD_PRELOAD}"
    fi
  fi
fi

if [[ "$#" -eq 0 ]]; then
  if [[ "$runtime_kind" == local ]]; then
    if [[ -z "${DISPLAY:-}" ]]; then
      set -- -bl -d gxdummy -h gxdummy
    elif [[ -r "$plugin_dir/libgxdCairo.so" &&
            -r "$plugin_dir/libgxpCairo.so" ]]; then
      set -- -l
    elif [[ -r "$plugin_dir/libgxdX11.so" ]]; then
      # X11 provides an interactive window without Cairo. Keep hardcopy on
      # the dummy device when the Cairo printing plug-in was not built.
      set -- -l -d X11 -h gxdummy
    else
      set -- -bl -d gxdummy -h gxdummy
    fi
  else
    set -- -l
  fi
fi

color_args=()
if [[ "${OPENGRADS_COLOR:-1}" != 0 ]]; then
  color_args=(-C "${OPENGRADS_COLOR_SCHEME:-1}")
fi

exec "$grads_binary" "${color_args[@]}" "$@"
