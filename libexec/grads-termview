#!/usr/bin/env bash
# Added in 2026 for terminal graphics display; see COPYING.
#
# Shows the picture of a GrADS session that uses the terminal display
# (grads -d Term). GrADS starts this in a tmux pane beside itself; it can also
# be run by hand in another pane or window:
#
#   grads-termview DIR [GRADS_PID]
#
# DIR holds the pictures written by the terminal display, a file "seq" that
# names the latest one ("12 plot.png" or "13 plot.gif"), and a FIFO "notify"
# that GrADS writes a line to whenever the picture changes, so the viewer
# sleeps until there is something to show. The picture is drawn with the
# iTerm2 inline image protocol, which iTerm2 and WezTerm understand, and fills
# the pane; an animated GIF plays by itself. Inside tmux the image is passed
# through to the outer terminal. The viewer exits when GRADS_PID is gone or
# DIR is removed.

set -u

dir="${1:-}"
grads_pid="${2:-}"
if [[ -z "$dir" ]]; then
  printf 'usage: %s DIR [GRADS_PID]\n' "${0##*/}" >&2
  exit 2
fi

seq_file="$dir/seq"
fifo="$dir/notify"
shown=""
redraw=1
have_fifo=0

# iTerm2 and tmux both drop a control sequence over 1 MiB; a larger file is
# sent in parts, which iTerm2 understands from version 3.5.
seq_limit=1000000
part_size=65536

if [[ -n "${TMUX:-}" ]]; then
  osc_open=$'\033Ptmux;\033\033]'
  osc_close=$'\a\033\\'
else
  osc_open=$'\033]'
  osc_close=$'\a'
fi

b64()
{
  # GNU base64 wraps lines unless told not to; BSD and macOS base64 do not.
  base64 -w 0 "$1" 2>/dev/null || base64 < "$1" | tr -d '\n'
}

show()
{
  local file="$dir/$1" cols rows size args
  read -r rows cols < <(stty size 2>/dev/null || echo "24 80")
  (( rows > 1 )) || rows=24
  (( cols > 0 )) || cols=80
  # Clear the pane, scrollback included, and home the cursor.
  printf '\033[H\033[2J\033[3J'
  if [[ ! -s "$file" ]]; then
    printf 'Waiting for a GrADS picture...\n'
    return
  fi
  size=$(wc -c < "$file" | tr -d ' ')
  # One row is left free so the image never scrolls the pane.
  args="inline=1;size=$size;width=$cols;height=$((rows - 1));preserveAspectRatio=1"
  if (( (size + 2) / 3 * 4 + 200 < seq_limit )); then
    printf '%s1337;File=%s:' "$osc_open" "$args"
    b64 "$file"
    printf '%s' "$osc_close"
  else
    printf '%s1337;MultipartFile=%s%s' "$osc_open" "$args" "$osc_close"
    b64 "$file" | fold -w "$part_size" |
      O="$osc_open" C="$osc_close" \
      awk '{ printf "%s1337;FilePart=%s%s", ENVIRON["O"], $0, ENVIRON["C"] }'
    printf '%s1337;FileEnd%s' "$osc_open" "$osc_close"
  fi
}

# The FIFO is opened for reading and writing, so opening it never blocks and
# a resize can wake the loop by writing to it.
if [[ -p "$fifo" ]] && exec 3<>"$fifo"; then
  have_fifo=1
fi
trap 'redraw=1; (( have_fifo )) && printf "\n" >&3' WINCH
trap 'printf "\033[?25h\033[H\033[2J"; exit 0' INT TERM HUP

# No echo or cursor in the viewer pane.
stty -echo 2>/dev/null || true
printf '\033[?25l'

while :; do
  if [[ -n "$grads_pid" ]] && ! kill -0 "$grads_pid" 2>/dev/null; then
    break
  fi
  [[ -d "$dir" ]] || break
  current=""
  name=""
  [[ -r "$seq_file" ]] && read -r current name < "$seq_file"
  [[ -n "$name" ]] || name=plot.png
  if [[ "$current" != "$shown" ]]; then
    shown="$current"
    redraw=1
  fi
  if (( redraw )); then
    redraw=0
    show "$name"
  fi
  # Sleep until GrADS has a new picture or the pane is resized. The timeout
  # only notices GrADS exiting.
  if (( have_fifo )); then
    read -r -t 1 -u 3 _ || true
  else
    sleep 0.2
  fi
done

printf '\033[?25h'
